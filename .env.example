# ── Local development ───────────────────────────────────────────────────────
# Client-side API (browser) — local/dev direct to Laravel
VITE_API_BASE_URL=https://datacontroller.fayshop.co.ke/backend/public/api

# Server-side SSR auth validation — use HTTP locally to avoid self-signed cert errors in Node
VITE_API_BASE_URL_SSR=https://datacontroller.fayshop.co.ke/backend/public/api

# Worker /api proxy target (only used in Cloudflare builds; optional for local vite)
# VITE_API_UPSTREAM=https://datacontroller.fayshop.co.ke/backend/public/api

# Set to false in dev if you must use HTTPS for SSR and have installed Laragon's CA in Node
# VITE_ALLOW_SELF_SIGNED_CERT=false

# ── Deployed environments (committed templates) ─────────────────────────────
# Production:  .env.production  →  npm run deploy:production  →  sight.fayshop.co.ke
# Staging:     .env.staging     →  npm run deploy:staging     →  staging.sight.fayshop.co.ke
# See docs/STAGING-AND-PRODUCTION.md
