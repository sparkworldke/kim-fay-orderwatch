APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Frontend URLs by environment (see docs/STAGING-AND-PRODUCTION.md):
#   Local:      http://localhost:5173  (or :8080)
#   Staging:    https://staging.sight.fayshop.co.ke
#   Production: https://sight.fayshop.co.ke
#   Legacy:     https://orderwatch.fayshop.co.ke  (redirects to production Sight)
# Server templates: .env.staging.example  |  .env.production.example
FRONTEND_URL=http://localhost:5173

CRON_TIMEZONE=Africa/Nairobi

# Solutech SFA BI (SELECT-only account; never expose through VITE_ variables)
SFA_DB_HOST=
SFA_DB_PORT=1166
SFA_DB_DATABASE=
SFA_DB_USERNAME=
SFA_DB_PASSWORD=
SFA_DB_SSL_CA=
SFA_SYNC_TIMEZONE=Africa/Nairobi
SFA_SYNC_QUEUE=sfa-sync
SFA_LATE_THRESHOLD=08:30

# AI executive image reports (server-side only)
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT=150

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1200

CACHE_STORE=redis
DASHBOARD_CACHE_STORE=redis
DASHBOARD_CACHE_FALLBACK_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=kimfay_orderwatch_database_
CACHE_PREFIX=kimfay_orderwatch_cache_

# Production: use smtp so daily reports and sync monitor alerts can be delivered.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@kimfay.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=kimfay.com

# WhatsApp OTP delivery (password update / optional future login codes)
# log = local/testing only; meta = Meta Cloud API
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Optional approved authentication template name (recommended for production)
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en

# Default PCR workflow email recipients (comma-separated). Overridable in Admin PCR settings
# via mail_recipients / attach_mail_recipients (dynamic list; stage/consultant not auto-mailed).
PCR_MAIL_RECIPIENTS=commercialtechlead@kimfay.com

# FOL / KP approval emails
# From address must be sendable by MAIL_USERNAME (or use the same working mailbox).
FOL_MAIL_FROM_ADDRESS="hello@fayshop.co.ke"
FOL_MAIL_FROM_NAME="FOL KP Approvals"
# When true, ALL FOL workflow emails go only to FOL_MAIL_TESTING_RECIPIENT
# (intended stage recipients are still logged). Set false for real production delivery.
FOL_MAIL_TESTING_MODE=true
FOL_MAIL_TESTING_RECIPIENT=commercialtechlead@kimfay.com
# Optional always-CC list (comma-separated). In testing mode, only the testing recipient is used.
FOL_CC_WATCHER_EMAILS=commercialtechlead@kimfay.com

# AI / Kimfay Genius (server-side only — never expose in frontend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
AI_PROVIDER_ORDER=openai,xai,anthropic
AI_OPENAI_MODEL=gpt-4o-mini
AI_XAI_MODEL=grok-4.5
AI_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
AI_HTTP_TIMEOUT_SECONDS=120
# When false, Generate fails clearly if the model/key is unavailable (no fake "success" template).
AI_ALLOW_TEMPLATE_FALLBACK=false
AI_GENIUS_WEEK_START=monday
AI_GENIUS_TZ=Africa/Nairobi

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Acumatica OAuth2 password grant
ACUMATICA_BASE_URL=https://kimfay.acumatica.com
ACUMATICA_TOKEN_URL=https://kimfay.acumatica.com/identity/connect/token
ACUMATICA_CLIENT_ID=
ACUMATICA_CLIENT_SECRET=
ACUMATICA_USERNAME=
ACUMATICA_PASSWORD=
ACUMATICA_ENDPOINT=IpayV2
ACUMATICA_VERSION=22.200.001
ACUMATICA_TENANT="Kim-Fay Limited"
# IpayV2 22.200.001 rejects SalesInvoice Details/any(OrderNbr) OData filters.
# Leave false unless a newer endpoint revision is confirmed to support it.
ACUMATICA_SALES_INVOICE_DETAIL_FILTER_SUPPORTED=false

# Microsoft OAuth / Outlook
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI="${APP_URL}/api/admin/mailboxes/oauth/callback"
MICROSOFT_GRAPH_USER_AGENT="Sight/1.0 (Kim-Fay Sight; +https://sight.fayshop.co.ke)"
# Deprecated: use FRONTEND_URL. Kept for backward compatibility if FRONTEND_URL is unset.
MICROSOFT_FRONTEND_URL=http://localhost:5173

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Backorder reason SLA (elapsed days before an unassigned line is flagged)
BACKORDER_MISSING_REASON_EXCEPTION_DAYS=7
