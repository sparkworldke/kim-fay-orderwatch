# ── Staging (Kim-Fay Sight) ─────────────────────────────────────────────────
# Used by: npm run build:staging / npm run deploy:staging
#
# Browser → same-origin /api (Worker proxies to VITE_API_UPSTREAM)
VITE_API_BASE_URL=/api

# Point these at your staging Laravel API (must end with /api).
# Default below matches the recommended hostname in docs/STAGING-AND-PRODUCTION.md
# Change if your staging API lives elsewhere (e.g. path on the same VPS).
VITE_API_UPSTREAM=https://api-staging.sight.fayshop.co.ke/api
VITE_API_BASE_URL_SSR=https://api-staging.sight.fayshop.co.ke/api

# Temporary: until api-staging is live, you can point at a path on the API host:
# VITE_API_UPSTREAM=https://datacontroller.fayshop.co.ke/staging/backend/public/api
# VITE_API_BASE_URL_SSR=https://datacontroller.fayshop.co.ke/staging/backend/public/api
