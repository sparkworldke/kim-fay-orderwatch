# ── Production (Kim-Fay Sight) ──────────────────────────────────────────────
# Used by: npm run build / npm run build:production / npm run deploy:production
#
# Browser → same-origin /api (Worker proxies to VITE_API_UPSTREAM)
VITE_API_BASE_URL=/api

# Worker /api proxy + SSR auth validation (Laravel absolute URL, ends with /api)
# Intended production API host
VITE_API_UPSTREAM=https://datacontroller.fayshop.co.ke/backend/public/api
VITE_API_BASE_URL_SSR=https://datacontroller.fayshop.co.ke/backend/public/api
